    ------ JOYSTICK OK---------------------------------------------------

   cantidad_datos_Joystick: constant := 200;
    type Indice_Secuencia_Joystick is mod cantidad_datos_Joystick;
    type tipo_Secuencia_Joystick is array (Indice_Secuencia_Joystick) 
                                             of Joystick_Samples_Type;

    Joystick_Simulation: tipo_Secuencia_Joystick :=  
       -- 0..4 s: Alabeo positivo extremo puro (0, +50). 
       -- Comprueba el límite estructural de +45 y el mensaje de aviso por superar los 35 grados.
       ((+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),
        (+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),
        (+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),
        (+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),(+00,+50),
       -- 4..8 s: Alabeo negativo extremo puro (0, -50). 
       -- Comprueba el límite de -45 y el aviso por debajo de -35.
        (+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),
        (+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),
        (+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),
        (+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),(+00,-50),
       -- 8..12 s: Banda muerta en ambos ejes (+2, -2). 
       -- El sistema debe leerlos como 0, no mostrar avisos y anular incrementos de velocidad.
        (+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),
        (+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),
        (+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),
        (+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),(+02,-02),
       -- 12..16 s: Maniobra combinada: Ascenso y Alabeo (+30, +40). 
       -- Detonará la suma máxima de velocidad combinada (+200 km/h) sin llegar al tope del sistema.
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
       -- 16..20 s: Misma maniobra combinada (+30, +40), pero probando estrés de motores.
       -- Buscará rebasar el límite de velocidad por culpa de la aerodinámica.
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),
        (+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40),(+30,+40));

